VITE_APP_NAME=ZENTROROX

# Real backend (default for development)
VITE_USE_LOCAL_API=false
VITE_API_BASE_URL=/api/v1

# Production build (required — vite build fails if missing):
# VITE_API_BASE_URL=https://api.yourdomain.com/api/v1

# Optional: browser-only demo without MongoDB
# VITE_USE_LOCAL_API=true
